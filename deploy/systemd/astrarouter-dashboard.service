# AstraRouter dashboard -- native systemd unit.
#
# The dashboard is a Next.js standalone server: `npm ci && npm run build` in the
# dashboard checkout produces .next/standalone/server.js, which is all this unit
# runs. It holds no secrets itself; the admin key below is only proxied
# server-side to the gateway, never exposed to the browser.
#
# Install (paths match install/native defaults):
#
#   sudo install -d -m 0750 -o astrarouter -g astrarouter /opt/astrarouter
#   sudo cp -r dashboard /opt/astrarouter/dashboard
#   sudo chown -R astrarouter:astrarouter /opt/astrarouter/dashboard
#   sudo -u astrarouter bash -c 'cd /opt/astrarouter/dashboard && npm ci --no-audit --no-fund && npm run build'
#   sudo install -m 0644 deploy/systemd/astrarouter-dashboard.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now astrarouter-dashboard
#
# Configuration lives in /etc/astrarouter/native.env (mode 0600), written by
# `astrarouter native install`. Only three variables matter here:
#
#   ASTRAROUTER_API_URL    gateway as seen from this server, e.g. http://127.0.0.1:8080
#   ASTRAROUTER_ADMIN_KEY  same value as the gateway's AR_ADMIN_KEY
#   PORT                  listen port (3000)
#
# Put a reverse proxy in front and terminate TLS there; this unit binds
# loopback by default (HOSTNAME below).

[Unit]
Description=AstraRouter control-plane dashboard
Documentation=https://github.com/shadowsafin/astrarouter
After=network-online.target astrarouter.service
Wants=network-online.target
# The dashboard is useless without the gateway, but a gateway restart must not
# take the dashboard down with it: it reconnects on the next request.

[Service]
Type=simple
User=astrarouter
Group=astrarouter
WorkingDirectory=/opt/astrarouter/dashboard

EnvironmentFile=-/etc/astrarouter/native.env
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
Environment=NODE_ENV=production

ExecStart=/usr/bin/node .next/standalone/server.js

# Node exits fast on SIGTERM; the timeout only covers in-flight page loads.
KillSignal=SIGTERM
TimeoutStopSec=30s

Restart=on-failure
RestartSec=3s
StartLimitIntervalSec=60s
StartLimitBurst=5

# Same sandbox posture as the gateway unit. Node needs no writable paths: the
# standalone server serves from its own directory read-only.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

LimitNOFILE=16384

StandardOutput=journal
StandardError=journal
SyslogIdentifier=astrarouter-dashboard

[Install]
WantedBy=multi-user.target
