# CoreRouter intelligence workers -- native systemd unit.
#
# The workers are a separate process from the gateway on purpose: telemetry
# aggregation and evaluation are CPU-bound and bursty, and a scoring loop that
# competes with the request path for CPU is a latency bug waiting to happen.
#
# Install (from the repository root, after `pip install ./workers` into a venv):
#
#   sudo install -d -m 0750 -o corerouter -g corerouter /opt/corerouter
#   sudo -u corerouter python3 -m venv /opt/corerouter/venv
#   sudo -u corerouter /opt/corerouter/venv/bin/pip install ./workers
#   sudo install -m 0644 deploy/systemd/corerouter-worker.service /etc/systemd/system/
#   sudo install -m 0600 -o corerouter -g corerouter /dev/null /etc/corerouter/worker-env
#   sudo systemctl daemon-reload && sudo systemctl enable --now corerouter-worker
#
# The unit is templatable (`corerouter-worker@.service`) so a deployment can run
# one process per pool; each instance is identified by CR_WORKER_LABELS and by
# its own durable consumer name.

[Unit]
Description=CoreRouter intelligence worker
Documentation=https://github.com/shadowsafin/corerouter
After=network-online.target nats.service
Wants=network-online.target
# The workers hold no local state: everything they produce is published to NATS
# or exposed as metrics. A restart loses at most one in-flight job, which
# JetStream redelivers (MaxDeliver is 5).

[Service]
Type=simple
User=corerouter
Group=corerouter

EnvironmentFile=-/etc/corerouter/worker-env

# `serve` runs the consumer loop: usage events, job dispatch and the periodic
# rollup publisher.
ExecStart=/opt/corerouter/venv/bin/corerouter-worker serve

# SIGTERM drains the current message and stops the consumer before exiting; a
# hard kill mid-job is safe but costs a redelivery.
KillSignal=SIGTERM
TimeoutStopSec=30s

Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=120s
StartLimitBurst=5

# Same sandbox as the gateway. The worker imports Python bytecode, so
# MemoryDenyWriteExecute is omitted: the CPython runtime needs writable-executable
# memory for some extensions, and enforcing it produces intermittent, confusing
# crashes rather than a clean refusal.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
ReadWritePaths=/var/lib/corerouter

LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=corerouter-worker

[Install]
WantedBy=multi-user.target
