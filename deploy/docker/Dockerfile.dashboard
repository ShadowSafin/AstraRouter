# AstraRouter dashboard.
#
# Built with Next.js standalone output so the runtime image ships the server
# bundle and its traced dependencies rather than node_modules. That is the
# difference between a ~150 MB and a ~1 GB image.

# ---------------------------------------------------------------------------
# Dependency stage.
# ---------------------------------------------------------------------------
FROM node:22-alpine AS deps

WORKDIR /app

# Both lockfiles are copied because the project pins with npm; copying only
# package.json would reinstall on every source change.
COPY dashboard/package.json dashboard/package-lock.json* ./
RUN npm ci --no-audit --no-fund

# ---------------------------------------------------------------------------
# Build stage.
# ---------------------------------------------------------------------------
FROM node:22-alpine AS builder

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY dashboard/ ./

# NEXT_PUBLIC_* variables are inlined into the browser bundle at build time, so
# the API URL must be known here. The default targets the compose service name,
# which is correct for the shipped stack and overridable for any other.
ARG NEXT_PUBLIC_ASTRAROUTER_API_URL=http://localhost:8080
ENV NEXT_PUBLIC_ASTRAROUTER_API_URL=${NEXT_PUBLIC_ASTRAROUTER_API_URL} \
    NEXT_TELEMETRY_DISABLED=1

RUN npm run build

# ---------------------------------------------------------------------------
# Runtime stage.
# ---------------------------------------------------------------------------
FROM node:22-alpine AS runtime

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN addgroup -g 10001 -S nextjs \
 && adduser -u 10001 -S -G nextjs nextjs

WORKDIR /app

# Standalone output is a self-contained server with only the modules it traced.
COPY --from=builder --chown=nextjs:nextjs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nextjs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nextjs /app/public ./public

USER nextjs

EXPOSE 3000

# The dashboard is a read-only console: a load balancer should remove it from
# rotation rather than restart it, so the check targets the lightweight root.
HEALTHCHECK --interval=20s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server.js"]
