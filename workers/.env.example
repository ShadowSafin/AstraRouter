# AstraRouter intelligence workers - example environment.
#
# Copy to .env and adjust. Every value here has a working default in config.py,
# so an empty file is a valid configuration when NATS is reachable on localhost.
#
# The prefix is AR_WORKER_ rather than AR_ so a worker and the Go control plane can
# share one environment without one silently reconfiguring the other.

# --- messaging ------------------------------------------------------------
# The broker the control plane publishes to. NATS_URL is accepted as a fallback
# so a container can be pointed at a shared broker without a second variable.
AR_WORKER_NATS_URL=nats://localhost:4222
AR_WORKER_NATS_NAME=astrarouter-workers
# A credentials file takes precedence over a token when both are set.
# AR_WORKER_NATS_CREDENTIALS_FILE=/etc/astrarouter/worker.creds
# AR_WORKER_NATS_TOKEN=
AR_WORKER_NATS_JETSTREAM=true
# Queue group for core NATS subscriptions. Two pools in the same group share work.
AR_WORKER_QUEUE_GROUP=astrarouter-workers
AR_WORKER_ACK_WAIT_SECONDS=120
AR_WORKER_MAX_DELIVER=5

# --- optional offline judge ----------------------------------------------
# Leave PROVIDER_URL empty to disable judging entirely. When set, it must be an
# OpenAI-compatible endpoint; a local runtime is the intended target, because
# judging with a hosted model would put evaluation cost on the bill the workers
# exist to reduce.
# AR_WORKER_PROVIDER_URL=http://localhost:11434/v1
# AR_WORKER_PROVIDER_MODEL=llama3.1:8b
# AR_WORKER_PROVIDER_API_KEY=
AR_WORKER_PROVIDER_TIMEOUT_SECONDS=60

# --- analysis limits -----------------------------------------------------
# Prompts larger than this are flagged rather than analysed in full.
AR_WORKER_ANALYSIS_MAX_TOKENS=128000
AR_WORKER_EVAL_CONCURRENCY=4

# --- observability -------------------------------------------------------
AR_WORKER_METRICS_ENABLED=true
AR_WORKER_METRICS_ADDR=0.0.0.0:9101
AR_WORKER_LOG_LEVEL=info
AR_WORKER_LOG_FORMAT=json

# --- attribution ---------------------------------------------------------
# Applied to results whose job arrived without a tenant.
AR_WORKER_DEFAULT_TENANT_ID=
# Propagated into every log line and metric, so two pools are distinguishable in
# a dashboard that aggregates them.
# AR_WORKER_LABELS=pool=eval,region=eu-west-1
